<script>
(function () {
  const storageKey = "hallowstead.noteLikes";
  const cookieMaxAge = 60 * 60 * 24 * 365;
  const buttons = document.querySelectorAll(".note-like-button");

  function parseState(raw) {
    try {
      const parsed = JSON.parse(raw);
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch {
      return {};
    }
  }

  function readState() {
    try {
      const stored = localStorage.getItem(storageKey);
      if (stored) {
        return parseState(stored);
      }
    } catch {}

    const cookie = document.cookie
      .split(";")
      .map(c => c.trim())
      .find(c => c.startsWith(storageKey + "="));

    if (cookie) {
      return parseState(
        decodeURIComponent(cookie.slice(storageKey.length + 1))
      );
    }

    return {};
  }

  function writeState(state) {
    try {
      localStorage.setItem(storageKey, JSON.stringify(state));
    } catch {}

    document.cookie =
      storageKey +
      "=" +
      encodeURIComponent(JSON.stringify(state)) +
      "; Max-Age=" +
      cookieMaxAge +
      "; Path=/; SameSite=Lax";
  }

  async function loadFromServer() {
    try {
      const response = await fetch("/api/likes", {
        cache: "no-store",
      });

      if (!response.ok) {
        return {};
      }

      return await response.json();
    } catch {
      return {};
    }
  }

  async function syncWithServer(noteId, action) {
    try {
      const response = await fetch("/api/likes", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          noteId,
          action,
        }),
      });

      if (!response.ok) {
        return null;
      }

      return await response.json();
    } catch {
      return null;
    }
  }

  function updateButton(button, count, liked) {
    button.dataset.liked = liked;

    button.querySelector(".note-like-icon").textContent =
      liked ? "♥" : "♡";

    button.querySelector(".note-like-label").textContent =
      liked ? "Liked" : "Like";

    button.querySelector(".note-like-count").textContent =
      `${count} ${count === 1 ? "like" : "likes"}`;
  }

  async function refresh(button) {
    const noteId = button.dataset.noteId;

    const localState = readState();
    const liked = !!localState[noteId];

    const serverState = await loadFromServer();

    const count = Number(serverState[noteId]) || 0;

    updateButton(button, count, liked);
  }

  buttons.forEach(button => {
    refresh(button);

    const toggle = button.querySelector(".note-like-toggle");

    toggle.addEventListener("click", async () => {
      toggle.disabled = true;

      const noteId = button.dataset.noteId;

      const localState = readState();
      const liked = !!localState[noteId];

      if (liked) {
        delete localState[noteId];
      } else {
        localState[noteId] = true;
      }

      writeState(localState);

      const result = await syncWithServer(
        noteId,
        liked ? "unlike" : "like"
      );

      if (result) {
        updateButton(
          button,
          result.count,
          !liked
        );
      } else {
        if (liked) {
          localState[noteId] = true;
        } else {
          delete localState[noteId];
        }

        writeState(localState);

        await refresh(button);
      }

      toggle.disabled = false;
    });
  });
})();
</script>