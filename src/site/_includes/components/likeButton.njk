{% set noteId = page.filePathStem | replace('/notes/', '') %}
{% if noteId %}
<div class="note-like-button" data-note-id="{{ noteId }}" data-liked="false">
  <button type="button" class="note-like-toggle" aria-label="Like this note">
    <span class="note-like-icon" aria-hidden="true">♡</span>
    <span class="note-like-label">Like</span>
  </button>
  <span class="note-like-count" aria-live="polite">0 likes</span>
</div>

<style>
  .note-like-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1rem 0 1.5rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--background-modifier-border, rgba(255, 255, 255, 0.2));
    border-radius: 999px;
    background: var(--background-secondary, rgba(255, 255, 255, 0.05));
    width: fit-content;
  }

  .note-like-toggle {
    border: none;
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
    font: inherit;
    background: var(--interactive-accent, #7c3aed);
    color: white;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .note-like-toggle:hover {
    opacity: 0.92;
  }

  .note-like-button[data-liked="true"] .note-like-toggle {
    background: var(--text-accent, #dc2626);
  }

  .note-like-count {
    font-size: 0.95rem;
    color: var(--text-muted, #6b7280);
  }
</style>

<script>
(function () {
  const storageKey = "hallowstead.noteLikes";
  const cookieMaxAge = 60 * 60 * 24 * 365;
  const buttons = document.querySelectorAll(".note-like-button");

  function parseState(raw) {
    try {
      const parsed = JSON.parse(raw);
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch {
      return {};
    }
  }

  function readState() {
    try {
      const stored = window.localStorage.getItem(storageKey);
      if (stored) {
        return parseState(stored);
      }
    } catch {
      // fall through to cookie and server state
    }

    const cookie = document.cookie
      .split(";")
      .map((entry) => entry.trim())
      .find((entry) => entry.startsWith(`${storageKey}=`));

    if (cookie) {
      return parseState(decodeURIComponent(cookie.slice(storageKey.length + 1)));
    }

    return {};
  }

  function writeState(state) {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(state));
    } catch {
      // ignore storage write failures and rely on cookies and the API
    }

    document.cookie = `${storageKey}=${encodeURIComponent(JSON.stringify(state))}; Max-Age=${cookieMaxAge}; Path=/; SameSite=Lax`;
  }

  async function syncWithServer(nextState) {
    try {
      const response = await fetch("/api/likes", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(nextState),
      });

      if (!response.ok) {
        return null;
      }

      return response.json();
    } catch {
      return null;
    }
  }

  async function loadFromServer() {
    try {
      const response = await fetch("/api/likes");
      if (!response.ok) {
        return {};
      }
      return response.json();
    } catch {
      return {};
    }
  }

  async function updateButtonState(button, noteId) {
    const state = await loadFromServer();
    const entry = state[noteId] || { count: 0, liked: false };
    updateButton(button, entry.count, entry.liked);
  }

  function updateButton(button, count, liked) {
    const label = button.querySelector(".note-like-label");
    const icon = button.querySelector(".note-like-icon");
    const countNode = button.querySelector(".note-like-count");

    button.setAttribute("data-liked", liked ? "true" : "false");
    label.textContent = liked ? "Liked" : "Like";
    icon.textContent = liked ? "♥" : "♡";
    countNode.textContent = `${count} ${count === 1 ? "like" : "likes"}`;
  }

  buttons.forEach((button) => {
    const noteId = button.getAttribute("data-note-id");
    const toggle = button.querySelector("button");

    updateButtonState(button, noteId);

    toggle.addEventListener("click", async () => {
      const localState = readState();
      const current = localState[noteId] || { count: 0, liked: false };
      const nextLiked = !current.liked;
      const nextCount = nextLiked
        ? (Number(current.count) || 0) + 1
        : Math.max(0, (Number(current.count) || 0) - 1);

      const nextState = {
        ...localState,
        [noteId]: { count: nextCount, liked: nextLiked },
      };

      writeState(nextState);
      const syncedState = await syncWithServer(nextState);
      const syncedEntry = (syncedState && syncedState[noteId]) || nextState[noteId];
      updateButton(button, syncedEntry.count, syncedEntry.liked);
    });
  });
})();
</script>
{% endif %}
