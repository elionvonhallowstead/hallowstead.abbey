{% set noteId = bookId %}
{% if noteId %}

<div
  class="note-like-button"
  data-note-id="{{ noteId }}"
  data-liked="false"
>
  <button
    type="button"
    class="note-like-toggle"
    aria-label="Like this note"
  >
    <span class="note-like-icon">♡</span>
    <span class="note-like-label">Like</span>
  </button>

  <span class="note-like-count">
    0 likes
  </span>
</div>

<style>
.note-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1rem;
}

.note-title {
  margin: 0;
  flex: 1;
}

.note-like-button {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: .5rem;

  padding: .5em 1.2em;

  background: var(--tag-background);
  border: var(--tag-border-width) solid var(--tag-border-color);
  border-radius: var(--tag-radius);

  font-size: var(--tag-size);
  font-weight: var(--tag-weight);
  line-height: 1;

  transition:
    background-color .15s,
    border-color .15s;
}

.note-like-button:hover {
  background: var(--tag-background-hover);
  border-color: var(--tag-border-color-hover);
}

button.note-like-toggle {
  appearance: none;
  background-color: rgba(0, 0, 0, 0);
  border: none;
  padding: 0;

  display: inline-flex;
  align-items: center;
  gap: .6rem;

  font: inherit;
  text-decoration: var(--tag-decoration);
  cursor: pointer;

  transition: color .15s;
}

button.note-like-toggle:hover {
  background-color: rgba(0, 0, 0, 0);
  text-decoration: var(--tag-decoration-hover);
}

note-like-label {
  padding-right: .4em;
}

not-like-icon {
  padding-left: .4em;
}

.note-like-button[data-liked="true"] .note-like-toggle {
  color: rgb(209.304, 137.496, 137.496);
}

.note-like-count {
  opacity: .8;
  white-space: nowrap;
}
</style>

<script>
(() => {

const STORAGE_KEY = "hallowstead.noteLikes";
const COOKIE_MAX_AGE = 60 * 60 * 24 * 365;

const buttons = document.querySelectorAll(".note-like-button");

if (!buttons.length) return;

function parse(raw) {
  try {
    return JSON.parse(raw) || {};
  } catch {
    return {};
  }
}

function readLocal() {
  try {
    const value = localStorage.getItem(STORAGE_KEY);
    if (value) return parse(value);
  } catch {}

  const cookie = document.cookie
    .split(";")
    .map(v => v.trim())
    .find(v => v.startsWith(STORAGE_KEY + "="));

  if (!cookie) return {};

  return parse(
    decodeURIComponent(cookie.slice(STORAGE_KEY.length + 1))
  );
}

function writeLocal(state) {
  try {
    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify(state)
    );
  } catch {}

  document.cookie =
    STORAGE_KEY +
    "=" +
    encodeURIComponent(JSON.stringify(state)) +
    "; Max-Age=" +
    COOKIE_MAX_AGE +
    "; Path=/; SameSite=Lax";
}

async function fetchLikes() {
  const res = await fetch("/api/likes", {
    cache: "no-store"
  });

  if (!res.ok)
    throw new Error("Failed loading likes");

  return res.json();
}

async function sendLike(noteId, action) {
  const res = await fetch("/api/likes", {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      noteId,
      action
    })
  });

  if (!res.ok)
    throw new Error("Failed updating like");

  return res.json();
}

function render(button, count, liked) {
  button.dataset.liked = liked;

  button.querySelector(".note-like-icon").textContent =
    liked ? "♥" : "♡";

  button.querySelector(".note-like-label").textContent =
    liked ? "Liked" : "Like";

  button.querySelector(".note-like-count").textContent =
    `${count} ${count === 1 ? "like" : "likes"}`;
}

buttons.forEach(async button => {

  const noteId = button.dataset.noteId;

  const toggle =
    button.querySelector(".note-like-toggle");

  let state = readLocal();
  let liked = !!state[noteId];

  try {

    const likes = await fetchLikes();
    const count = Number(likes[noteId] || 0);

    render(button, count, liked);

  } catch {

    render(button, 0, liked);

  }

  window.addEventListener("storage", () => {
    state = readLocal();
    liked = !!state[noteId];
    const currentCount = Number(
      button.querySelector(".note-like-count").textContent.split(" ")[0]
    ) || 0;
    render(button, currentCount, liked);
  });

  toggle.addEventListener("click", async () => {

    toggle.disabled = true;

    state = readLocal();
    liked = !!state[noteId];

    if (liked)
      delete state[noteId];
    else
      state[noteId] = true;

    writeLocal(state);

    try {

      const result = await sendLike(
        noteId,
        liked ? "unlike" : "like"
      );

      render(
        button,
        result.count,
        !liked
      );

    } catch (err) {

      console.error(err);

      if (liked)
        state[noteId] = true;
      else
        delete state[noteId];

      writeLocal(state);

      render(
        button,
        Number(button.querySelector(".note-like-count").textContent.split(" ")[0]) || 0,
        liked
      );

    }

    toggle.disabled = false;

  });

});

})();
</script>

{% endif %}
