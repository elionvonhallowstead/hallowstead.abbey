{% set noteId = page.filePathStem | replace('/notes/', '') %}
{% if noteId %}
<div class="note-like-button" data-note-id="{{ noteId }}" data-liked="false">
  <button type="button" class="note-like-toggle" aria-label="Like this note">
    <span class="note-like-icon" aria-hidden="true">♡</span>
    <span class="note-like-label">Like</span>
  </button>
  <span class="note-like-count" aria-live="polite">0 likes</span>
</div>

<style>
  .note-like-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1rem 0 1.5rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--background-modifier-border, rgba(255, 255, 255, 0.2));
    border-radius: 999px;
    background: var(--background-secondary, rgba(255, 255, 255, 0.05));
    width: fit-content;
  }

  .note-like-toggle {
    border: none;
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
    font: inherit;
    background: var(--interactive-accent, #7c3aed);
    color: white;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .note-like-toggle:hover {
    opacity: 0.92;
  }

  .note-like-button[data-liked="true"] .note-like-toggle {
    background: var(--text-accent, #dc2626);
  }

  .note-like-count {
    font-size: 0.95rem;
    color: var(--text-muted, #6b7280);
  }
</style>

<script>
(function () {
  const storageKey = "hallowstead.noteLikes";
  const buttons = document.querySelectorAll(".note-like-button");

  function readState() {
    try {
      return JSON.parse(window.localStorage.getItem(storageKey) || "{}");
    } catch {
      return {};
    }
  }

  function writeState(state) {
    window.localStorage.setItem(storageKey, JSON.stringify(state));
  }

  function updateButton(button, count, liked) {
    const label = button.querySelector(".note-like-label");
    const icon = button.querySelector(".note-like-icon");
    const countNode = button.querySelector(".note-like-count");

    button.setAttribute("data-liked", liked ? "true" : "false");
    label.textContent = liked ? "Liked" : "Like";
    icon.textContent = liked ? "♥" : "♡";
    countNode.textContent = `${count} ${count === 1 ? "like" : "likes"}`;
  }

  buttons.forEach((button) => {
    const noteId = button.getAttribute("data-note-id");
    const state = readState();
    const entry = state[noteId] || { count: 0, liked: false };
    const toggle = button.querySelector("button");

    updateButton(button, entry.count, entry.liked);

    toggle.addEventListener("click", () => {
      const nextState = readState();
      const current = nextState[noteId] || { count: 0, liked: false };
      const nextLiked = !current.liked;
      const nextCount = nextLiked
        ? (Number(current.count) || 0) + 1
        : Math.max(0, (Number(current.count) || 0) - 1);

      nextState[noteId] = { count: nextCount, liked: nextLiked };
      writeState(nextState);
      updateButton(button, nextCount, nextLiked);
    });
  });
})();
</script>
{% endif %}
