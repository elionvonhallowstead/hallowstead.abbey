{% set noteId = page.filePathStem | replace('/notes/', '') %}
{% if noteId %}
<div class="note-like-button" data-note-id="{{ noteId }}" data-liked="false">
  <button type="button" class="note-like-toggle" aria-label="Like this note">
    <span class="note-like-icon" aria-hidden="true">♡</span>
    <span class="note-like-label">Like</span>
  </button>
  <span class="note-like-count" aria-live="polite">0 likes</span>
</div>

<style>
  .note-like-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1rem 0 1.5rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--background-modifier-border, rgba(255, 255, 255, 0.2));
    border-radius: 999px;
    background: var(--background-secondary, rgba(255, 255, 255, 0.05));
    width: fit-content;
  }

  .note-like-toggle {
    border: none;
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
    font: inherit;
    background: var(--interactive-accent, #7c3aed);
    color: white;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .note-like-toggle:hover {
    opacity: 0.92;
  }

  .note-like-button[data-liked="true"] .note-like-toggle {
    background: var(--text-accent, #dc2626);
  }

  .note-like-count {
    font-size: 0.95rem;
    color: var(--text-muted, #6b7280);
  }
</style>

<script>
(function () {
  const storageKey = "hallowstead.noteLikes";
  const cookieMaxAge = 60 * 60 * 24 * 365;
  const buttons = document.querySelectorAll(".note-like-button");

  function parseState(raw) {
    try {
      const parsed = JSON.parse(raw);
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch {
      return {};
    }
  }

  function readState() {
    try {
      const stored = localStorage.getItem(storageKey);
      if (stored) {
        return parseState(stored);
      }
    } catch {}

    const cookie = document.cookie
      .split(";")
      .map((c) => c.trim())
      .find((c) => c.startsWith(storageKey + "="));

    if (cookie) {
      return parseState(
        decodeURIComponent(cookie.slice(storageKey.length + 1))
      );
    }

    return {};
  }

  function writeState(state) {
    try {
      localStorage.setItem(storageKey, JSON.stringify(state));
    } catch {}

    document.cookie =
      storageKey +
      "=" +
      encodeURIComponent(JSON.stringify(state)) +
      "; Max-Age=" +
      cookieMaxAge +
      "; Path=/; SameSite=Lax";
  }

  async function loadFromServer() {
    try {
      const response = await fetch("/api/likes", {
        cache: "no-store",
      });

      if (!response.ok) {
        return {};
      }

      return await response.json();
    } catch {
      return {};
    }
  }

  async function syncWithServer(noteId, action) {
    try {
      const response = await fetch("/api/likes", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          noteId,
          action,
        }),
      });

      if (!response.ok) {
        return null;
      }

      return await response.json();
    } catch {
      return null;
    }
  }

  function updateButton(button, count, liked) {
    button.dataset.liked = liked ? "true" : "false";

    button.querySelector(".note-like-label").textContent =
      liked ? "Liked" : "Like";

    button.querySelector(".note-like-icon").textContent =
      liked ? "♥" : "♡";

    button.querySelector(".note-like-count").textContent =
      count + " " + (count === 1 ? "like" : "likes");
  }

  async function updateButtonState(button, noteId) {
    const serverState = await loadFromServer();

    const localState = readState();

    const liked = !!localState[noteId];

    const count = Number(serverState[noteId]) || 0;

    updateButton(button, count, liked);
  }

  buttons.forEach((button) => {
    const noteId = button.dataset.noteId;
    const toggle = button.querySelector(".note-like-toggle");

    updateButtonState(button, noteId);

    toggle.addEventListener("click", async () => {
      toggle.disabled = true;

      const localState = readState();

      const liked = !!localState[noteId];

      if (liked) {
        delete localState[noteId];
      } else {
        localState[noteId] = true;
      }

      writeState(localState);

      const result = await syncWithServer(
        noteId,
        liked ? "unlike" : "like"
      );

      if (result) {
        updateButton(
          button,
          Number(result.count) || 0,
          !liked
        );
      } else {
        // Roll back local state if the request failed
        if (liked) {
          localState[noteId] = true;
        } else {
          delete localState[noteId];
        }

        writeState(localState);

        await updateButtonState(button, noteId);
      }

      toggle.disabled = false;
    });
  });
})();
</script>
{% endif %}
